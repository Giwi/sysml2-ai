{
  "id": "editor-rename",
  "title": "Rename a part definition and update all references",
  "tags": ["edit", "rename", "transaction"],
  "role": "editor",
  "fixture": "vehicle",
  "goal": "Rename Vehicle::Chassis to Frame and keep the model valid.",
  "targetFiles": ["model.sysml"],
  "provider": { "kind": "script" },
  "script": [
    { "toolCalls": [{ "name": "model.get_element", "arguments": { "qname": "Vehicle::Chassis" } }] },
    { "toolCalls": [{ "name": "model.find_references", "arguments": { "qname": "Vehicle::Chassis" } }] },
    {
      "toolCalls": [
        { "name": "model.rename_element", "arguments": { "qname": "Vehicle::Chassis", "newName": "Frame", "updateReferences": true } }
      ]
    },
    { "toolCalls": [{ "name": "model.validate", "arguments": {} }] },
    {
      "toolCalls": [
        {
          "name": "agent.finish",
          "arguments": {
            "summary": "Renamed Vehicle::Chassis to Vehicle::Frame and updated the chassis typing reference.",
            "claims": ["Vehicle::Frame exists", "Vehicle::Chassis no longer exists"],
            "confidence": 0.99
          }
        }
      ]
    }
  ],
  "expect": {
    "status": "completed",
    "valid": true,
    "changed": true,
    "elementsPresent": [{ "qname": "Vehicle::Frame", "kind": "Part Definition" }],
    "elementsAbsent": ["Vehicle::Chassis"],
    "requiredTools": ["model.rename_element", "model.validate"],
    "maxSteps": 7,
    "maxToolCalls": 7,
    "maxToolErrors": 0,
    "summaryContains": ["Vehicle::Frame"]
  }
}
